def binary2base64(binary):
    return base64.b64encode(binary).decode()


def base642binary(string):
    return base64.b64decode(string)


def post(url, data):
    result = requests.post(url=url, json=data)
    try:
        return result.json()
    except:
        return result.content

def ocr_recognize(image):
    # 接收图片并返回文本
    url = "http://10.0.2.100:35000"
    # 图片转换为字节流
    with io.BytesIO() as output:
        image.save(output, format='PNG')
        img_data = output.getvalue()
    # 发送POST请求
    response = requests.post(url, files={'file': img_data})
# 返回的是所有json数据
    if response.status_code == 200:
        result = response.json()
        data = result.get('data', [])

        all_fields = []
        for item in data:
            # 提取data里面的坐标
            messages = item.get('image_dection_message', [])
            all_fields.extend(messages)
        return all_fields
    else:
        return "识别失败"

def get_doc(server_name):
    # 初始化
    st.session_state['server_doc'] = []

    data = {
        "name": server_name,
        "action": "get_doc"
    }

    result = requests.post(url=st.session_state["api_gateway_address"], json=data).json()
    if result['code'] == '0':
        st.session_state['server_doc'] = result['data']
    else:
        st.session_state['server_doc'] = False
    return st.session_state['server_doc']


